Flag(FileOn("machine.pmi.res")) & Set(toto | current_floor: INTEGER & current_floor: NATURAL & travel_direction: (1..2)*{DIRECTIONS} & SERVED = {0|->(1|->DIRECTIONS)|->({1|->BUTTONS}\/{4|->BUTTONS})}\/{0|->(2|->DIRECTIONS)|->({1|->BUTTONS}\/{4|->BUTTONS})}\/{1|->(1|->DIRECTIONS)|->({2|->BUTTONS}\/{5|->BUTTONS})}\/{1|->(2|->DIRECTIONS)|->({2|->BUTTONS}\/{6|->BUTTONS})}\/{2|->(1|->DIRECTIONS)|->({3|->BUTTONS}\/{7|->BUTTONS})}\/{2|->(2|->DIRECTIONS)|->({3|->BUTTONS}\/{7|->BUTTONS})} & current_floor: INTEGER & 0<=current_floor & current_floor: NATURAL & current_floor: 0..2 & travel_direction: (1..2)*{DIRECTIONS} & (current_floor = 0 => travel_direction = 1|->DIRECTIONS) & (current_floor = 2 => travel_direction = 2|->DIRECTIONS) & current_floor<=2 => ("Operation is well defined" => current_floor|->travel_direction: dom(SERVED)))